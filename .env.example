# Generate with: openssl rand -hex 32 (64 hex characters)
AUTH_SECRET=

# Demo credentials are disabled in production unless both flags are explicitly enabled.
ENABLE_DEMO_ACCOUNT=false
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/aggregator

# Optional metadata enrichment
TMDB_API_KEY=

# Optional cache
REDIS_URL=redis://localhost:6379

# Frontend -> backend
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Exact HTTPS hostnames permitted for server-side stream health checks
STREAM_PROBE_ALLOWED_HOSTS=media.cinejoy.pk,media.cinelite.xyz,media.vivarium.st,media.movy.sx

# First-party catalogue feeds (each must be HTTPS on a host in DISCOVERY_ALLOWED_HOSTS)
CINEJOY_CATALOG_FEED_URL=
CINELITE_CATALOG_FEED_URL=
VIVARIUM_CATALOG_FEED_URL=
MOVY_CATALOG_FEED_URL=

# Exact hostnames permitted for authorized recursive discovery
DISCOVERY_ALLOWED_HOSTS=cinejoy.pk,www.cinejoy.pk,cinelite.xyz,www.cinelite.xyz,vivarium.st,www.vivarium.st,movy.sx,www.movy.sx

# Emails explicitly permitted to use the discovery admin interface (must also have role=admin)
DISCOVERY_ADMIN_EMAILS=you@example.com

# Generate with: openssl rand -hex 32
DISCOVERY_API_KEY=
